{
  "name": "linghu-draw",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "art": "node scripts/build-art.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:lan": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "tsx tests/run.ts && tsx tests/cinnabar-brush.ts && tsx tests/progress.ts && tsx tests/spirit-pen.ts && tsx tests/ink.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check:platform": "tsx scripts/check-platform.ts",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "build:wechat": "tsc --noEmit && node scripts/build-wechat.mjs",
    "test:wechat": "tsx tests/wechat.ts && node scripts/check-wechat-render.mjs",
    "test:ink:preview": "node scripts/check-ink.mjs",
    "test:practice": "tsx tests/practice.ts"
  },
  "dependencies": {
    "pixi.js": "^8.14.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "tsx": "^4.20.0",
    "sharp": "^0.34.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.55.0"
  }
}
