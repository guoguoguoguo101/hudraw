    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check:platform": "tsx scripts/check-platform.ts",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "build:wechat": "tsc --noEmit && node scripts/build-wechat.mjs",
    "test:wechat": "tsx tests/wechat.ts && node scripts/check-wechat-render.mjs",
    "test:ink:preview": "node scripts/check-ink.mjs",
