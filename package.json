    "test:paper-tiger:preview": "node scripts/check-paper-tiger.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.14.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "tsx": "^4.20.0",
    "sharp": "^0.34.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.55.0"
  }
