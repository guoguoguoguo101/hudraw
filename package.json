    "test:talisman-barrage:preview": "node scripts/check-talisman-barrage.mjs",
    "test:burning-sea": "tsx tests/burning-sea.ts",
    "test:burning-sea:preview": "node scripts/check-burning-sea.mjs",
    "test:performance:preview": "node scripts/check-experiment-performance.mjs",
    "profile:combat": "node scripts/profile-combat.mjs",
    "test:functional-relics": "tsx tests/functional-relics.ts",
    "test:functional-relics:preview": "node scripts/check-functional-relics.mjs",
    "test:hualing": "tsx tests/hualing.ts",
    "test:paper-monsters:preview": "node scripts/check-paper-monsters.mjs",
    "test:hualing:preview": "node scripts/check-hualing.mjs",
    "test:hualing-resonance:preview": "node scripts/check-hualing-resonance.mjs",
    "test:hualing-landscape:preview": "node scripts/check-hualing-landscape.mjs",
    "test:practice": "tsx tests/practice.ts",
    "test:fallback": "tsx tests/fallback-slash.ts",
    "test:fallback:preview": "node scripts/check-fallback-slash.mjs",
    "test:triangle-refraction": "tsx tests/triangle-refraction.ts",
    "test:line-interactions": "tsx tests/line-interactions.ts",
